TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_SEO_THREAD_ID=
TELEGRAM_ALLOWED_USERS=
SEO_TELEGRAM_ENABLED=false

# Production gateway alternative when the host cannot reach api.telegram.org:
TELEGRAM_GATEWAY_URL=
TELEGRAM_GATEWAY_SECRET=

# Stage C-E analytics. Leave SEO_ANALYTICS_ENABLED=0 until the read-only
# credentials below are installed and verified.
SEO_ANALYTICS_ENABLED=0
TOPVISOR_USER_ID=
TOPVISOR_API_KEY=
YANDEX_WEBMASTER_TOKEN=
YANDEX_METRIKA_TOKEN=
# Optional allow-list of Metrika goal IDs. Empty means all goals returned by
# the counter Management API; conversions stay attributed to landing pages.
YANDEX_METRIKA_GOAL_IDS=

# Disabled reserve only. seo_positions.py refuses to use it while
# positions.yandex_search_api.enabled=false in seo-settings.json.
YANDEX_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
YANDEX_REGION_ID=39
SEO_POSITION_SEARCH_DEPTH=100
SEO_POSITION_DEVICE=desktop
# Optional; default is storage/app/private/seo-analytics/positions.sqlite3.
SEO_POSITIONS_DB=
